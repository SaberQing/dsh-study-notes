{
  "name": "@local/dsh-study-notes",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "DSH plugin: select text to ask in an isolated right-sidebar branch that never enters the main conversation context, with persistent highlights, notes index, locate-to-conversation, optional memory, reinjection, Markdown/KaTeX and Markdown/Word export.",
  "license": "MIT",
  "author": "SaberQing",
  "homepage": "https://github.com/SaberQing/dsh-study-notes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaberQing/dsh-study-notes.git"
  },
  "bugs": {
    "url": "https://github.com/SaberQing/dsh-study-notes/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "study-notes",
    "highlight",
    "branch-chat",
    "education"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/public/*.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
